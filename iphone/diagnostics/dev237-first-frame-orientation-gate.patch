+
+- (void)idaredGuestPresentationCommitted:(NSNotification *)notification
+{
+    if (idaredPresentationCommitted) {
+        return;
+    }
+    idaredPresentationCommitted = YES;
+    UIView *coverHost = self.view.window ?: self.view;
+    idaredPresentationCover = [[UIView alloc] initWithFrame:coverHost.bounds];
+    idaredPresentationCover.backgroundColor = UIColor.blackColor;
+    idaredPresentationCover.autoresizingMask =
+        UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    idaredPresentationCover.userInteractionEnabled = NO;
+    [coverHost addSubview:idaredPresentationCover];
+
+    UIInterfaceOrientationMask guestMask = UIKit_GetSupportedOrientations(window);
+    UIInterfaceOrientation sceneOrientation = self.view.window.windowScene.interfaceOrientation;
+    UIInterfaceOrientationMask currentMask = IDaredMaskForInterfaceOrientation(sceneOrientation);
+    idared_native_presentation_diagnostic_event(
+        "sdl-first-frame-cover-installed",
+        [[NSString stringWithFormat:
+            @"controller=%@ generation=%@ source=%@ guestMask=0x%lx sceneOrientation=%ld currentMask=0x%lx",
+            IDaredUIKitObjectLabel(self),
+            notification.userInfo[@"generation"] ?: @"(null)",
+            notification.userInfo[@"source"] ?: @"(null)",
+            (unsigned long)guestMask,
+            (long)sceneOrientation,
+            (unsigned long)currentMask] UTF8String]);
+    if ((guestMask & currentMask) != 0) {
